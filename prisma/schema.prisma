generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model students {
  id                       BigInt    @id @default(autoincrement())
  first_name               String    @db.VarChar(50)
  last_name                String    @db.VarChar(50)
  gender                   String
  date_of_birth            DateTime? @db.Date
  mobile_no                String    @db.VarChar(15)
  alternate_mobile_no      String?   @db.VarChar(15)
  parent_mobile_no         String?   @db.VarChar(15)
  parent_name              String?   @db.VarChar(100)
  address                  String?   @db.Text
  location                 String?   @db.VarChar(100)
  pincode                  String?   @db.VarChar(10)
  state                    String?   @db.VarChar(50)
  email                    String    @unique @db.VarChar(100)
  username                 String    @unique @db.VarChar(50)
  password                 String    @db.VarChar(255)
  profile_pic              String?   @db.VarChar(150)
  cv_file_path             String?   @db.VarChar(255)
  qualification            String?   @db.VarChar(100)
  last_login_on            DateTime?
  status                   String    @default("Pending")
  forgot_pass_token        String?   @db.VarChar(255)
  forgot_pass_expiry       DateTime?
  forgot_pass_token_expiry DateTime?
  login_token              String?   @db.VarChar(255)
  login_status             String    @default("inactive")
  login_status_updated_at  DateTime?
  sales_person_name        String?   @db.VarChar(150)
  sales_person_phone       String?   @db.VarChar(20)
  paid_amount              Decimal   @default(0.00) @db.Decimal(10, 2)
  created_by               BigInt
  updated_by               BigInt
  special_category_id      BigInt?
  created_at               DateTime? @default(now())
  updated_at               DateTime? @updatedAt

  student_block_histories  student_block_histories[]
  student_drop_histories   student_drop_histories[]
  student_notifications    student_notifications[]
  student_leaves           student_leaves[]
  student_reports          student_reports[]
}

model leave_reasons {
  id             BigInt           @id @default(autoincrement())
  name           String           @db.VarChar(255)
  status         String           @default("active") @db.VarChar(30)
  created_by     BigInt?
  updated_by     BigInt?
  created_at     DateTime?        @default(now())
  updated_at     DateTime?        @updatedAt
  student_leaves student_leaves[]
}

model student_leaves {
  id                   BigInt         @id @default(autoincrement())
  student_id           BigInt
  start_date           DateTime       @db.Date
  end_date             DateTime       @db.Date
  no_of_days           Int?
  reason_id            BigInt?
  description          String?        @db.Text
  proof                String?        @db.VarChar(255)
  status               String         @default("pending") @db.VarChar(30)
  authorized_by        BigInt?
  authorization_remark String?        @db.Text
  created_by           BigInt?
  updated_by           BigInt?
  created_at           DateTime?      @default(now())
  updated_at           DateTime?      @updatedAt

  student              students       @relation(fields: [student_id], references: [id], onDelete: Cascade)
  reason               leave_reasons? @relation(fields: [reason_id], references: [id])
}

model student_block_reasons {
  id         BigInt    @id @default(autoincrement())
  name       String    @db.VarChar(255)
  status     String    @default("active")
  created_by BigInt?
  updated_by BigInt?
  created_at DateTime? @default(now())
  updated_at DateTime? @updatedAt

  student_block_histories student_block_histories[]
}

model student_block_histories {
  id           BigInt                 @id @default(autoincrement())
  student_id   BigInt
  reason_id    BigInt?
  description  String?                @db.Text
  blocked_by   BigInt?
  unblocked_by BigInt?
  status       String                 @default("blocked")
  created_at   DateTime?              @default(now())
  updated_at   DateTime?              @updatedAt

  student      students               @relation(fields: [student_id], references: [id])
  reason       student_block_reasons? @relation(fields: [reason_id], references: [id])
}

model student_drop_histories {
  id         BigInt    @id @default(autoincrement())
  student_id BigInt
  reason     String?   @db.Text
  dropped_by BigInt?
  created_at DateTime? @default(now())
  updated_at DateTime? @updatedAt

  student    students  @relation(fields: [student_id], references: [id])
}

model student_notifications {
  id         BigInt    @id @default(autoincrement())
  student_id BigInt
  title      String?   @db.VarChar(255)
  message    String?   @db.Text
  status     String    @default("new")
  type       String?   @db.VarChar(100)
  created_at DateTime? @default(now())
  updated_at DateTime? @updatedAt

  student    students  @relation(fields: [student_id], references: [id])
}

model daily_quotes {
  id         BigInt    @id @default(autoincrement())
  quote      String    @db.Text
  status     String    @default("active")
  created_at DateTime? @default(now())
  updated_at DateTime? @updatedAt
}

model institution_roles {
  id                BigInt              @id @default(autoincrement())
  name              String              @db.VarChar(100)
  status            String              @default("Active")
  created_by        BigInt
  updated_by        BigInt
  created_at        DateTime?
  updated_at        DateTime?
  institution_users institution_users[]
}

model password_reset_tokens {
  id         BigInt    @id @default(autoincrement())
  email      String    @db.VarChar(100)
  token      String    @unique @db.VarChar(255)
  guard      String    @default("student") @db.VarChar(30)
  expires_at DateTime
  created_at DateTime? @default(now())

  @@index([email, guard])
}

model programs {
  id          BigInt     @id @default(autoincrement())
  code        String?    @unique @db.VarChar(50)
  name        String     @db.VarChar(150)
  description String?    @db.Text
  language    String     @default("English") @db.VarChar(50)
  icon        String?    @db.VarChar(255)
  cover_image String?    @db.VarChar(255)
  status      String     @default("Active") @db.VarChar(30)
  created_by  BigInt
  updated_by  BigInt
  created_at  DateTime?  @default(now())
  updated_at  DateTime?  @updatedAt
  sections    sections[]
}

model sections {
  id                    BigInt                  @id @default(autoincrement())
  program_id            BigInt
  code                  String?                 @unique @db.VarChar(50)
  name                  String                  @db.VarChar(150)
  icon                  String?                 @db.VarChar(255)
  cover_image           String?                 @db.VarChar(255)
  duration              String?                 @db.VarChar(50)
  amount                Decimal?                @default(0.00) @db.Decimal(10, 2)
  priority              Int?                    @default(0)
  description           String?                 @db.Text
  duration_in_months    Int?
  status                String                  @default("Active") @db.VarChar(30)
  is_demo               Boolean                 @default(false)
  created_by            BigInt
  updated_by            BigInt
  created_at            DateTime?               @default(now())
  updated_at            DateTime?               @updatedAt
  program               programs                @relation(fields: [program_id], references: [id])
  modules               modules[]
  program_section_batches program_section_batches[]
}

model modules {
  id          BigInt      @id @default(autoincrement())
  section_id  BigInt
  name        String      @db.VarChar(150)
  description String?     @db.Text
  order       Int         @default(0)
  status      String      @default("Active") @db.VarChar(30)
  created_by  BigInt
  updated_by  BigInt
  created_at  DateTime?   @default(now())
  updated_at  DateTime?   @updatedAt
  section     sections    @relation(fields: [section_id], references: [id])
  topics      topics[]
  student_section_modules student_section_modules[]
}

model topics {
  id           BigInt        @id @default(autoincrement())
  module_id    BigInt
  name         String        @db.VarChar(200)
  description  String?       @db.Text
  type         String        @default("video") @db.VarChar(30)
  cover_image  String?       @db.VarChar(255)
  file_url     String?       @db.VarChar(500)
  day_count    Int?          @default(1)
  priority     Int?          @default(0)
  content_url  String?       @db.VarChar(500)
  order        Int           @default(0)
  status       String        @default("Active") @db.VarChar(30)
  created_by   BigInt
  updated_by   BigInt
  created_at   DateTime?     @default(now())
  updated_at   DateTime?     @updatedAt
  module       modules       @relation(fields: [module_id], references: [id])
  topic_files  topic_files[]
  topic_assessments topic_assessments[]
  student_section_module_topics student_section_module_topics[]
}

model topic_files {
  id         BigInt    @id @default(autoincrement())
  topic_id   BigInt
  file_name  String    @db.VarChar(255)
  file_path  String    @db.VarChar(500)
  file_type  String?   @db.VarChar(50)
  created_by BigInt
  created_at DateTime? @default(now())
  topic      topics    @relation(fields: [topic_id], references: [id])
}

model topic_assessments {
  id              BigInt   @id @default(autoincrement())
  topic_id        BigInt
  question        String   @db.Text
  options         Json
  answer          Json?
  correct_answer  String?  @db.VarChar(10)
  marks           Int      @default(1)
  priority        Int?     @default(1)
  status          String   @default("Active") @db.VarChar(30)
  created_by      BigInt?
  updated_by      BigInt?
  created_at      DateTime? @default(now())
  updated_at      DateTime? @updatedAt
  topic           topics   @relation(fields: [topic_id], references: [id])
  student_topic_assessment_answers student_topic_assessment_answers[]
}

model student_topic_assessment_answers {
  id                  BigInt            @id @default(autoincrement())
  student_id          BigInt
  student_topic_id    BigInt
  topic_id            BigInt
  topic_assessment_id BigInt
  answer              String?           @db.Text
  marks               Boolean           @default(false)
  created_at          DateTime?         @default(now())
  updated_at          DateTime?         @updatedAt
  topic_assessment    topic_assessments @relation(fields: [topic_assessment_id], references: [id])
}

model special_categories {
  id          BigInt    @id @default(autoincrement())
  name        String    @db.VarChar(100)
  description String?   @db.Text
  status      String    @default("Active") @db.VarChar(30)
  created_by  BigInt
  updated_by  BigInt
  created_at  DateTime? @default(now())
  updated_at  DateTime? @updatedAt
}

model program_section_batches {
  id                   BigInt             @id @default(autoincrement())
  section_id           BigInt
  batch_name           String             @db.VarChar(150)
  tutor_id             BigInt?
  qa_id                BigInt?
  placement_officer_id BigInt?
  start_date           DateTime?          @db.Date
  end_date             DateTime?          @db.Date
  status               String             @default("Active") @db.VarChar(30)
  created_by           BigInt
  updated_by           BigInt
  created_at           DateTime?          @default(now())
  updated_at           DateTime?          @updatedAt
  section              sections           @relation(fields: [section_id], references: [id])
  student_sections     student_sections[]
}

model student_sections {
  id               BigInt                  @id @default(autoincrement())
  student_id       BigInt
  batch_id         BigInt
  start_date       DateTime?               @db.Date
  end_date         DateTime?               @db.Date
  status           String                  @default("Active") @db.VarChar(30)
  progress_percent Decimal                 @default(0.00) @db.Decimal(5, 2)
  self_placed      String?                 @db.VarChar(10)
  created_by       BigInt
  updated_by       BigInt
  created_at       DateTime?               @default(now())
  updated_at       DateTime?               @updatedAt
  batch            program_section_batches @relation(fields: [batch_id], references: [id])
  student_section_modules student_section_modules[]

  @@unique([student_id, batch_id])
}

model student_section_modules {
  id                          BigInt          @id @default(autoincrement())
  student_id                  BigInt?
  student_section_id          BigInt
  module_id                   BigInt
  status                      String          @default("Locked") @db.VarChar(30)
  unlock_requested            Boolean         @default(false)
  unlock_requested_by         BigInt?
  unlock_requested_at         DateTime?
  unlocked_by                 BigInt?
  unlocked_at                 DateTime?
  marks_scored                Int?
  total_marks                 Int?
  percentage                  Decimal?        @db.Decimal(5, 2)
  remarks                     String?         @db.Text
  evaluated_by                BigInt?
  evaluated_at                DateTime?
  performance                 String?         @db.VarChar(30)
  performance_description     String?         @db.Text
  performance_created_by      BigInt?
  performance_created_at      DateTime?
  created_at                  DateTime?       @default(now())
  updated_at                  DateTime?       @updatedAt
  student_section             student_sections @relation(fields: [student_section_id], references: [id])
  module                      modules         @relation(fields: [module_id], references: [id])
  student_section_module_topics student_section_module_topics[]

  @@unique([student_section_id, module_id])
}

model student_section_module_topics {
  id                          BigInt                  @id @default(autoincrement())
  student_id                  BigInt
  student_section_module_id   BigInt
  topic_id                    BigInt
  status                      String                  @default("new") @db.VarChar(30)
  created_by                  BigInt?
  created_at                  DateTime?               @default(now())
  topic_started_by            BigInt?
  topic_started_at            DateTime?
  topic_last_accessed_at      DateTime?
  topic_completed_at          DateTime?
  student_section_module      student_section_modules @relation(fields: [student_section_module_id], references: [id])
  topic                       topics                  @relation(fields: [topic_id], references: [id])
}

model program_extensions {
  id                 BigInt    @id @default(autoincrement())
  student_section_id BigInt
  requested_by       BigInt
  reason             String    @db.Text
  extension_months   Int
  status             String    @default("Pending") @db.VarChar(30)
  reviewed_by        BigInt?
  reviewed_at        DateTime?
  created_at         DateTime? @default(now())
  updated_at         DateTime? @updatedAt
}

model institution_users {
  id                       BigInt            @id @default(autoincrement())
  role_id                  BigInt
  first_name               String            @db.VarChar(50)
  last_name                String            @db.VarChar(50)
  gender                   String
  date_of_birth            DateTime?         @db.Date
  mobile_no                String?           @db.VarChar(15)
  address                  String?           @db.Text
  location                 String?           @db.VarChar(100)
  pincode                  String?           @db.VarChar(10)
  state                    String?           @db.VarChar(50)
  email                    String            @unique @db.VarChar(100)
  username                 String            @unique @db.VarChar(50)
  password                 String            @db.VarChar(255)
  profile_pic              String?           @db.VarChar(150)
  qualification            String?           @db.VarChar(100)
  last_login_on            DateTime?
  status                   String            @default("Active")
  forgot_pass_token        String?           @db.VarChar(255)
  forgot_pass_token_expiry DateTime?
  created_by               BigInt
  updated_by               BigInt
  created_at               DateTime?
  updated_at               DateTime?
  role                     institution_roles @relation(fields: [role_id], references: [id])
  admin_notifications      admin_notifications[]
}

model admin_notifications {
  id         BigInt             @id @default(autoincrement())
  user_id    BigInt?
  message    String             @db.Text
  status     String             @default("new") @db.VarChar(30)
  created_at DateTime?          @default(now())
  updated_at DateTime?          @updatedAt
  user       institution_users? @relation(fields: [user_id], references: [id])
}

model fee_collections {
  id                 BigInt                     @id @default(autoincrement())
  student_id         BigInt
  student_section_id BigInt?
  installment_no     Int
  fee_amount         Decimal                    @default(0.00) @db.Decimal(10, 2)
  paid_amount        Decimal                    @default(0.00) @db.Decimal(10, 2)
  balance_amount     Decimal                    @default(0.00) @db.Decimal(10, 2)
  due_date           DateTime                   @db.Date
  fee_status         String                     @default("pending") @db.VarChar(30)
  approval_status    String                     @default("pending") @db.VarChar(30)
  created_by         BigInt?
  updated_by         BigInt?
  collected_by       BigInt?
  collected_at       DateTime?
  auth_by            BigInt?
  auth_at            DateTime?
  auth_remark        String?                    @db.Text
  created_at         DateTime?                  @default(now())
  updated_at         DateTime?                  @updatedAt
  histories          fee_collection_histories[]

  @@index([student_id])
  @@index([student_section_id])
  @@index([fee_status])
  @@index([approval_status])
  @@index([due_date])
}

model fee_collection_histories {
  id                BigInt          @id @default(autoincrement())
  fee_collection_id BigInt
  paid_amount       Decimal         @default(0.00) @db.Decimal(10, 2)
  collected_by      BigInt?
  collected_at      DateTime?
  record_status     String          @default("active") @db.VarChar(30)
  created_at        DateTime?       @default(now())
  updated_at        DateTime?       @updatedAt
  fee_collection    fee_collections @relation(fields: [fee_collection_id], references: [id], onDelete: Cascade)

  @@index([fee_collection_id])
  @@index([collected_at])
}

model student_report_heads {
  id              BigInt            @id @default(autoincrement())
  name            String            @db.VarChar(255)
  status          String            @default("active") @db.VarChar(30)
  created_by      BigInt?
  updated_by      BigInt?
  created_at      DateTime?         @default(now())
  updated_at      DateTime?         @updatedAt
  student_reports student_reports[]
}

model student_reports {
  id             BigInt                @id @default(autoincrement())
  student_id     BigInt
  report_head_id BigInt?
  description    String?               @db.Text
  status         String                @default("active") @db.VarChar(30)
  created_by     BigInt?
  updated_by     BigInt?
  created_at     DateTime?             @default(now())
  updated_at     DateTime?             @updatedAt
  student        students              @relation(fields: [student_id], references: [id], onDelete: Cascade)
  report_head    student_report_heads? @relation(fields: [report_head_id], references: [id], onDelete: SetNull)

  @@index([student_id])
  @@index([report_head_id])
}
